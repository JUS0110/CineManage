<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.ufrpe.cine_rural.gui.controllers_telas.IngressoController"
            prefWidth="900.0"
            prefHeight="700.0"
            stylesheets="@EstiloIngresso.css">

   <children>

      <VBox alignment="CENTER"
            spacing="30"
            AnchorPane.topAnchor="0.0"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0">

         <padding>
            <Insets top="60" bottom="60" left="80" right="80"/>
         </padding>

         <children>

            <!-- Título da tela -->
            <Label text="Emissão de Ingresso"
                   styleClass="label-titulo"
                   alignment="CENTER" />

            <!-- Subtítulo / instrução -->
            <Label text="Revise os dados abaixo e clique em Emitir para confirmar."
                   styleClass="label"
                   wrapText="true"
                   alignment="CENTER" />

            <!-- Botão principal de emissão -->
            <Button fx:id="btnEmissaoIngresso"
                    text="Emitir Ingresso"
                    onAction="#btnEmissaoIngressoImprimir"
                    prefWidth="300.0"
                    prefHeight="55.0"
                    style="-fx-font-size: 18px;" />

         </children>

      </VBox>

   </children>

</AnchorPane>
