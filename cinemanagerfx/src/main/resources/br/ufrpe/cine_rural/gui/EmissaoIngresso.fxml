<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.ufrpe.cine_rural.gui.controllers_telas.IngressoController"
            prefWidth="900.0"
            prefHeight="700.0"
            stylesheets="@EstiloIngresso.css">

   <children>

      <VBox alignment="CENTER"
            spacing="20"
            AnchorPane.topAnchor="0.0"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0">

         <children>
            <Button fx:id="btnEmissaoIngresso"
                    text="Emissão Ingresso"
                    onAction="#btnEmissaoIngressoImprimir"
                    prefWidth="300.0"
                    prefHeight="40.0"
                    style="-fx-font-size: 14px;" />
         </children>

      </VBox>

   </children>
</AnchorPane>